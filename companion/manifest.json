{
	"id": "android-tv",
	"name": "androidtv",
	"shortname": "androidtv",
	"description": "Android TV plugin for Companion",
	"version": "0.0.0",
	"license": "MIT",
	"repository": "git+https://github.com/bitfocus/companion-module-android-tv.git",
	"bugs": "https://github.com/bitfocus/companion-module-android-tv/issues",
	"maintainers": [
		{
			"name": "Brent Zerbe",
			"email": "zerbzman@gmail.com"
		}
	],
	"runtime": {
		"type": "node26",
		"api": "nodejs-ipc",
		"apiVersion": "0.0.0",
		"entrypoint": "../main.js",
		"permissions": {
			"child-process": true,
			"filesystem": true
		}
	},
	"legacyIds": ["companion-module-android-tv"],
	"manufacturer": "Google",
	"products": ["androidtv"],
	"keywords": ["TV"],
	"bonjourQueries": {
		"bonjour_host": {
			"type": "androidtvremote2",
			"protocol": "tcp"
		}
	}
}
